// Container layout (properties)
// Header container:  Height 80, Y 0
// Body container:    Y = Header.Height   Height = Parent.Height - Self.Y
// Card container:    Height = Parent.Height * 0.25
// Filter sidebar:    Width  = Parent.Width * 0.25
// Gallery container: Width  = Parent.Width * 0.75
// Separators:        vertical  Width 5, Height Parent.Height;  gallery row  Y = Parent.TemplateHeight - 2, Height 2
